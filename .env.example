# Copy to backend/.env and fill in. Never commit the real file.

# Postgres. Local default below; swap for the Tiger Data connection string.
DATABASE_URL=postgresql://localhost:5432/stone

# SEC requires a contact email in the User-Agent. No key.
SEC_USER_AGENT=Stone ShellHacks you@example.com

# Prices (Massive, formerly Polygon). Free tier: 5 requests/minute.
MASSIVE_API_KEY=

# FRED (DGS10). Free key.
FRED_API_KEY=

# Gemini (screenshot import, filing summaries). Free key from aistudio.google.com.
# Check it with: cd backend && uv run python scripts/check_gemini.py
GEMINI_API_KEY=
# Optional. Default gemini-3.8-flash; gemini-3.5-flash-lite is cheaper, with a higher free quota.
GEMINI_MODEL=

# Connected later (not used by the base yet)
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
ALPACA_API_KEY=
ALPACA_API_SECRET=
FINNHUB_API_KEY=
